<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Plugin">
            <directory>tests</directory>
            <exclude>tests/SuperNative</exclude>
        </testsuite>
        <!-- Boots NativeServiceProvider, which defines NativePHP's global
             nativephp_* polyfills for the rest of the process, so it runs last. -->
        <testsuite name="SuperNative">
            <directory>tests/SuperNative</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
