{
    "name": "ikromjon/nativephp-mobile-social-auth",
    "description": "Native social login for NativePHP Mobile 3.x and 4.x: Sign in with Apple on iOS and Google Sign-In (OAuth) on iOS and Android, using the platform SDKs.",
    "type": "nativephp-plugin",
    "license": "proprietary",
    "keywords": [
        "nativephp",
        "nativephp-plugin",
        "nativephp-mobile",
        "login",
        "social-login",
        "oauth",
        "authentication",
        "social-auth",
        "sign-in",
        "sign-in-with-apple",
        "apple-sign-in",
        "google-sign-in",
        "apple-login",
        "google-login",
        "ios",
        "android",
        "laravel",
        "mobile"
    ],
    "authors": [
        {
            "name": "Ikromjon Ochilov",
            "email": "ikromjon98.98@icloud.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^3.3.11|^4.6.1",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ikromjon\\NativePHP\\SocialAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ikromjon\\NativePHP\\SocialAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ikromjon\\NativePHP\\SocialAuth\\SocialAuthServiceProvider"
            ],
            "aliases": {
                "SocialAuth": "Ikromjon\\NativePHP\\SocialAuth\\Facades\\SocialAuth"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
